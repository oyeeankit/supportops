"use client";

import type React from "react";
import { useActionState } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select } from "@/components/ui/select";
import { leaveTypeLabels, leaveTypes } from "../types";
import { requestLeaveAction, type DailyOperationActionState } from "../actions";

const initialState: DailyOperationActionState = {};

export function LeaveRequestForm() {
  const [state, formAction, pending] = useActionState(requestLeaveAction, initialState);
  const errorFor = (field: string) => state.fieldErrors?.[field]?.[0];

  return (
    <Card>
      <CardHeader>
        <CardTitle>Request leave</CardTitle>
        <CardDescription>Approved leave is protected from performance penalties.</CardDescription>
      </CardHeader>
      <CardContent>
        <form action={formAction} className="space-y-4">
          <Field label="Leave type" error={errorFor("leave_type")}>
            <Select name="leave_type" defaultValue="casual">
              {leaveTypes.map((type) => (
                <option key={type} value={type}>
                  {leaveTypeLabels[type]}
                </option>
              ))}
            </Select>
          </Field>
          <div className="grid gap-4 sm:grid-cols-2">
            <Field label="Start date" error={errorFor("start_date")}>
              <Input name="start_date" type="date" required />
            </Field>
            <Field label="End date" error={errorFor("end_date")}>
              <Input name="end_date" type="date" required />
            </Field>
          </div>
          <Field label="Reason" error={errorFor("reason")}>
            <Input name="reason" placeholder="Short reason" required />
          </Field>
          {state.message ? (
            <div className="rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-200">
              {state.message}
            </div>
          ) : null}
          <Button type="submit" disabled={pending}>
            {pending ? "Submitting..." : "Submit leave request"}
          </Button>
        </form>
      </CardContent>
    </Card>
  );
}

function Field({
  label,
  error,
  children,
}: {
  label: string;
  error?: string;
  children: React.ReactNode;
}) {
  return (
    <div className="space-y-2">
      <Label>{label}</Label>
      {children}
      {error ? <p className="text-sm text-destructive">{error}</p> : null}
    </div>
  );
}
